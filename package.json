{
  "name": "codeville",
  "private": true,
  "version": "0.1.0",
  "description": "Drop a repo. Get a city.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "packageManager": "pnpm@10.12.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanitedhacker/codeville.git"
  },
  "bugs": {
    "url": "https://github.com/yanitedhacker/codeville/issues"
  },
  "homepage": "https://github.com/yanitedhacker/codeville#readme",
  "scripts": {
    "dev": "pnpm -F @codeville/web dev",
    "build": "pnpm -F @codeville/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "atlas": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
