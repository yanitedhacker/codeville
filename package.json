{
  "name": "codeville",
  "private": true,
  "version": "1.0.0",
  "description": "Drop a repo. Get a city.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "packageManager": "pnpm@10.12.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanitedhacker/codeville.git"
  },
  "bugs": {
    "url": "https://github.com/yanitedhacker/codeville/issues"
  },
  "homepage": "https://github.com/yanitedhacker/codeville#readme",
  "scripts": {
    "dev": "pnpm -F @codeville/web dev",
    "build": "pnpm -F @codeville/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "atlas": "tsx packages/cli/src/index.ts",
    "fidelity": "tsx scripts/fidelity.ts",
    "langs": "tsx scripts/langs.ts",
    "realrepo": "tsx scripts/realrepo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
